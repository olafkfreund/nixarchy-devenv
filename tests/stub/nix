#!/usr/bin/env bash
# A stand-in for nix in tests/cli.sh: records the call, and for `run` writes
# what a cloud generator leaves behind. The real generator runs only in
# `nix run .#templates-check`.
echo "$PWD :: nix $*" >>"$STUB_LOG"
case " $* " in
  *" run "*)
    if [ "${STUB_RUN_FAIL:-}" = 1 ]; then echo "stub nix: the generator failed" >&2; exit 1; fi
    printf '{ }\n' >devenv.nix
    printf 'inputs: {}\n' >devenv.yaml
    git init -q
    ;;
esac
