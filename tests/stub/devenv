#!/usr/bin/env bash
# A stand-in for devenv in tests/cli.sh: records every call to $STUB_LOG and
# does the least the CLI depends on. Never the real thing -- the real one is
# what `nix run .#templates-check` exercises.
echo "$PWD :: $*" >>"$STUB_LOG"
case "$1" in
  init)
    if [ "${STUB_INIT_FAIL:-}" = 1 ]; then echo "stub devenv: init failed" >&2; exit 1; fi
    cat >devenv.nix <<'NIX'
{ pkgs, lib, config, inputs, ... }:

{
  packages = [ pkgs.git ];

  # https://devenv.sh/languages/
  # languages.rust.enable = true;

  # processes.dev.exec = "ls";
}
NIX
    # devenv/init/devenv.yaml at 2.3.1: no top-level nixpkgs: key, only the
    # pre-2.0 allow_unfree, commented out. STUB_INIT_NIXPKGS=1 stands for a
    # future init that writes one, which the CLI must refuse to duplicate.
    cat >devenv.yaml <<'YAML'
# yaml-language-server: $schema=https://devenv.sh/devenv.schema.json
inputs:
  nixpkgs:
    url: github:cachix/devenv-nixpkgs/rolling

# If you're using non-OSS software, you can set allow_unfree to true.
# allow_unfree: true
YAML
    # STUB_INIT_NOPLACEHOLDER=1: a scaffold without the commented language
    # line, so the preset takes the splice's fallback path.
    if [ "${STUB_INIT_NOPLACEHOLDER:-}" = 1 ]; then sed -i '/# languages\.rust\.enable/d' devenv.nix; fi
    # STUB_INIT_NO_BRACE=1: neither the placeholder nor a '}' at column zero, so
  # the splice has nowhere safe to land and must refuse rather than underflow.
  if [ "${STUB_INIT_NO_BRACE:-}" = 1 ]; then
    sed -i -e '/# languages\.rust\.enable/d' -e 's/^}$/  }/' devenv.nix
  fi
  if [ "${STUB_INIT_NIXPKGS:-}" = 1 ]; then printf 'nixpkgs:\n  allow_broken: false\n' >>devenv.yaml; fi
    printf '.devenv*\n' >.gitignore
    ;;
  processes)
    case "${STUB_PROCESSES:-stopped}" in
      # The three answers devenv 2.3.1 gives, measured against a real one: a
      # table with exit 0; "No process manager is running" when it was shut
      # down cleanly; or a connection-refused error when the manager died
      # without cleaning up, leaving its socket behind.
      # Run by a program rather than a terminal, devenv also prints its
      # progress on stderr; only the rows with restarts: are processes.
      running) printf '• Validating lock\n✓ Validating lock in 15ms\n' >&2; printf 'web                            ready restarts: 0\ndb                             running restarts: 1\n' ;;
      noise) printf '• Validating lock\n' >&2 ;;
      stopped) echo "  x No process manager is running. Start processes first with \`devenv up -d\`" >&2; exit 1 ;;
      hang) sleep 30 ;;
      # crashed: the manager died without shutting down -- a crash, an OOM
      # kill, a kill -9 -- and left its socket behind. Measured from a real
      # devenv 2.3.1 after SIGKILLing the manager. It says nothing about a
      # process manager, so it must not read as stopped: we genuinely
      # cannot tell what is running, and unknown refuses removal.
      crashed) printf '  \xc3\x97 Failed to connect to native manager at /run/user/1000/devenv-67bca67/processes/native.sock\n   \xe2\x94\x80\xe2\x96\xb6 Connection refused (os error 111)\n' >&2; exit 1 ;;
      # slow: the stopped answer, three seconds late. The window between the
      # last check and the delete is only observable when the status call is
      # slow AND permissive; hang is slow but answers unknown, which refuses
      # on its own and so proves nothing about the window.
      slow) sleep 3; echo "  x No process manager is running. Start processes first with \`devenv up -d\`" >&2; exit 1 ;;
      # malformed: exit 0 and a line carrying the word but no count. Only a
      # `name status restarts: N` row is a process; this must read unknown.
      malformed) printf 'garbage running restarts: nope\n' ;;
      fail) echo "error: boom" >&2; exit 1 ;;
    esac
    ;;
  revoke)
    if [ "${STUB_REVOKE_FAIL:-}" = 1 ]; then echo "stub devenv: revoke failed" >&2; exit 1; fi
    ;;
  allow | version) ;;
esac
